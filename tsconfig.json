// Her pages (src/): checked by tsc (npm run typecheck), run as
// scripts/build-pages.mjs writes them into dist/, their types taken out and
// nothing else changed. So only TypeScript that is JavaScript once its types
// are gone (erasableSyntaxOnly: no enum, namespace or parameter properties),
// and an import that brings types alone says so (import type), else it would
// be left in. The tests have their own (test/tsconfig.json), with Node's types.
//
// Not strict yet: a parameter with no type is any (noImplicitAny off) and
// null is in every type (strictNullChecks off), so the pages as they were
// check; what each file exports, and so what one asks of another, is typed
// from what it does.
{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": [],
    "strict": false,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
