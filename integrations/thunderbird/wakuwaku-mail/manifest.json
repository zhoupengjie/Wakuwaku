{
  "manifest_version": 2,
  "name": "Wakuwaku Mail",
  "description": "New mail in Wakuwaku's island: the unread count, and the island opens for a new letter.",
  "version": "1.0",
  "author": "Wakuwaku",
  "homepage_url": "https://github.com/zhoupengjie/wakuwaku",
  "browser_specific_settings": {
    "gecko": {
      "id": "mail@wakuwaku",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["accountsRead", "messagesRead", "http://127.0.0.1/*"]
}
