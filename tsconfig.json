// Her pages (src/): checked by tsc (npm run typecheck), run as
// scripts/build-pages.mjs writes them into dist/, their types taken out and
// nothing else changed. So only TypeScript that is JavaScript once its types
// are gone (erasableSyntaxOnly: no enum, namespace or parameter properties),
// and an import that brings types alone says so (import type), else it would
// be left in. The tests have their own (test/tsconfig.json), with Node's types.
//
// Strict: every page file passes with it on (since 2026-11-12, the list
// tsconfig.strict.json had grown to all of them), and a new one must too.
{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": [],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
