// The pages' files that pass tsc with strict on (npm run typecheck, CI):
// each listed file's own code. tsc takes what they import into the check
// too (it has no other way), and scripts/typecheck-strict.mjs leaves out
// the errors in those until they are listed here as well. The list only
// grows: a file on it stays on it, and a file made strict is added.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "src/window.d.ts",
    "src/addon/sdk.ts",
    "src/shared/config.ts",
    "src/shared/i18n.ts",
    "src/pet/entry.ts",
    "src/pet/main.ts",
    "src/pet/desk-main.ts",
    "src/pet/bar-main.ts",
    "src/pet/barpop-main.ts",
    "src/pet/island-state.ts",
    "src/pet/island-vars.ts",
    "src/pet/settings-state.ts",
    "src/pet/settings-vars.ts",
    "src/pet/addons.ts",
    "src/pet/addonui.ts",
    "src/pet/agents.ts",
    "src/pet/aim.ts",
    "src/pet/anchor.ts",
    "src/pet/bar.ts",
    "src/pet/barpop.ts",
    "src/pet/bridge.ts",
    "src/pet/capsule-panel.ts",
    "src/pet/capsule.ts",
    "src/pet/desk-drop.ts",
    "src/pet/desk.ts",
    "src/pet/deskgrid.ts",
    "src/pet/flow.ts",
    "src/pet/handoff.ts",
    "src/pet/hovers.ts",
    "src/pet/island-plate.ts",
    "src/pet/mica.ts",
    "src/pet/panel.ts",
    "src/pet/pet.ts",
    "src/pet/picker.ts",
    "src/pet/placing.ts",
    "src/pet/presses.ts",
    "src/pet/sprite.ts",
    "src/pet/status.ts",
    "src/pet/views.ts",
    "src/pet/wcards.ts",
    "src/pet/wdesk.ts",
    "src/pet/widgets.ts"
  ]
}
